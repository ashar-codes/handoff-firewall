# scripts/setup.sh generates a random database password and matching DATABASE_URL.
POSTGRES_USER=handoff
POSTGRES_DB=handoff
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg://handoff:REPLACE_WITH_RANDOM_PASSWORD@127.0.0.1:5432/handoff
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
STORAGE_PATH=./data/files
MODEL_PROVIDER=ollama
MODEL_BASE_URL=http://127.0.0.1:11434
MODEL_NAME=qwen2.5:7b
MODEL_TIMEOUT=30
# Hosted alternative (send only data approved for that provider):
# MODEL_PROVIDER=groq
# MODEL_BASE_URL=https://api.groq.com/openai/v1
# MODEL_NAME=openai/gpt-oss-120b
# MODEL_REASONING_EFFORT=medium
# GROQ_API_KEY=  (secret; keep only in the git-ignored backend/.env)
MAX_STEPS=24
MAX_RUN_SECONDS=180
SESSION_HOURS=8

# Evidence storage: local files (default) or a private Supabase Storage bucket (backend only).
# STORAGE_PROVIDER=supabase
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=  (secret; never in Git or the browser)
# SUPABASE_STORAGE_BUCKET=handoff-evidence
# Deployment: see docs/DEPLOYMENT_GITHUB_RENDER_SUPABASE.md and docs/DEPLOYMENT_ENVIRONMENT.md
